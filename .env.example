# =====================================================================
# Vortex Insights — variáveis de ambiente (copie para .env)
# NUNCA commite o .env real. Rotacione qualquer chave que já tenha vazado.
# =====================================================================

# ---- Postgres (warehouse self-hosted) ----
POSTGRES_USER=vortex
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=vortex_insights
POSTGRES_PORT=5432
# URL usada por app e worker. Em Docker o host é "db"; rodando local é "localhost".
DATABASE_URL=postgres://vortex:troque_esta_senha@localhost:5432/vortex_insights

# ---- Instagram Graph API ----
IG_ACCESS_TOKEN=
# IG user id da conta
IG_USER_ID=
# Busca insights só de mídias dos últimos N dias (lifetime é caro)
IG_INSIGHTS_DAYS=90

# ---- Meta (Facebook) Marketing API ----
META_ACCESS_TOKEN=
# Conta de anúncios (act_…)
META_AD_ACCOUNT_ID=
META_LOOKBACK_DAYS=30
META_CHUNK_DAYS=7

# ---- Google Ads API ----
GADS_DEVELOPER_TOKEN=
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=
GADS_CUSTOMER_ID=
GADS_LOGIN_CUSTOMER_ID=
GADS_LOOKBACK_DAYS=7

# ---- Supabase (fonte de Vendas, alimentada pelo n8n) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cobrança (régua de WhatsApp; worker lê a planilha Google) ----
# Planilha alimentada pelo n8n.
SHEETS_COBRANCA_ID=
SHEETS_COBRANCA_GID=
# Opcional: range A1 explícito (ex.: 'Página1!A:U'). Vazio = resolve pela aba do gid.
SHEETS_COBRANCA_RANGE=
# Service account p/ ler a planilha de forma PRIVADA (recomendado p/ LGPD: tira o link público).
# JSON inline OU caminho do arquivo. Ausente = lê o CSV publicado (planilha precisa estar pública).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- App ----
# Base URL interna do app para chamadas server-side (opcional)
APP_PORT=3000
# Agendamento do ETL (cron). Vendas frequente; marketing diário; cobrança de hora em hora.
CRON_SALES=*/15 * * * *
CRON_MARKETING=0 5 * * *
CRON_COBRANCA=0 * * * *
# Liga/desliga o scheduler do worker (em dev pode rodar jobs manualmente)
ETL_SCHEDULE_ENABLED=true
